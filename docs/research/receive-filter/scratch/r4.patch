+        let mut on = look(band_db - 10.0, floor_db, gain);
+        for (k, v) in on.bins_db.iter_mut().enumerate() {
+            if (1100.0..1500.0).contains(&(k as f64 * BIN_HZ)) {
+                *v = band_db + 10.0;
+            }
+        }
