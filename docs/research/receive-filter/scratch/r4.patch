+    }
+
+    /// [`LOOKS_KEPT`] looks of `gain`, the block of [`with_block`] on in seven of every ten.
+    fn block_on_most_of_the_time(
+        mut filter: ReceiveFilter,
+        gain: impl Fn(f64) -> f32,
+    ) -> ReceiveFilter {
+        let (on, off) = (with_block(-60.0, -110.0, &gain), look(-60.0, -110.0, &gain));
+        for k in 0..LOOKS_KEPT {
+            filter.fold(if k % 10 < 7 { &on } else { &off });
+        }
+        filter
+    }
